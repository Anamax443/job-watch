# Vzor lokálních secrets. Zkopíruj na `.dev.vars` (které je v .gitignore) a vyplň.
# Na produkci nastav přes: wrangler secret put NAZEV

# Anthropic API — VOLITELNÉ. Skórování jede defaultně zdarma na Cloudflare Workers AI
# (binding [ai] ve wrangler.toml). Klíč je potřeba jen pro placený Claude backend
# a pro deanonymizaci agentur / screening zdrojů (web_search/web_fetch).
# Backend se přepíná v Nastavení (settings.aiProvider) nebo přes var AI_PROVIDER.
ANTHROPIC_API_KEY=

# Telegram bot (token je tajný; cílový chat_id se nastavuje v UI / settings)
TELEGRAM_BOT_TOKEN=

# Microsoft Graph (odesílání e-mailu, client credentials flow)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Odesílací schránka (UPN/e-mail), ze které se posílá sendMail
GRAPH_MAILBOX=

# Slack Incoming Webhook URL (volitelné; zapni v Nastavení přepínačem „Posílat na Slack")
SLACK_WEBHOOK_URL=

# Adzuna Job API (konkrétní inzeráty pro web zdroj; zdarma na developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Serper.dev (alternativa – Google seznamy; už se nepoužívá pro web zdroj)
SERPER_API_KEY=
